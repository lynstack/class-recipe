{
  "name": "@lynstack/class-recipe",
  "version": "1.0.0",
  "description": "Fast, type-safe class name recipes with variants, compound variants, and slots, plus a clsx-compatible cx.",
  "keywords": [
    "class",
    "classnames",
    "clsx",
    "cva",
    "recipe",
    "slots",
    "tailwind",
    "variants"
  ],
  "homepage": "https://lynstack.github.io/class-recipe/",
  "bugs": "https://github.com/lynstack/class-recipe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynstack/class-recipe.git"
  },
  "license": "MIT",
  "author": "Tim Phan",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm build && vitest bench --run",
    "check": "pnpm build && pnpm typecheck && pnpm test:consumer && pnpm lint && pnpm format:check && pnpm test",
    "prepack": "pnpm build",
    "test:consumer": "tsc -p fixtures/consumer/tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@vitest/coverage-v8": "5.0.3",
    "class-variance-authority": "0.7.1",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "publishConfig": {
    "access": "public"
  }
}
